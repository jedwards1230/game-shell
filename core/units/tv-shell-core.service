[Unit]
# tv-shell-core — the v2 policy process. UNTESTED ON HARDWARE — see the header
# in tv-shell-session.target.
#
# Started by `Wants=` on tv-shell-session.target, not by an [Install] section:
# the session target is the single owner of this unit's lifecycle, exactly as
# the v1 session script is for tv-shell-input.service. Enabling it into
# default.target would start a second, compositor-less copy at user-manager boot.
Description=tv-shell v2 core (gamescope base-layer policy, launching, IPC)

# ORDERING IS ON THE COMPOSITOR, NOT ON graphical-session.target.
#
# This used to read `After=graphical-session.target` alone, which is vacuous on
# every relogin. That target is only ever `Wants=`-ed here, never `PartOf=`/
# `BindsTo=`, and the session script's cleanup does not stop it — so on any
# second start within the same user-manager lifetime it is ALREADY ACTIVE, the
# ordering is satisfied instantly, and the core races gamescope to the X server.
# The target's own `After=tv-shell-gamescope.service` does not help: `Upholds=`
# carries no ordering (§4 says so explicitly), so it never ordered this unit.
#
# Ordering directly on the compositor unit is what actually holds, because
# gamescope is Type=notify and its READY=1 is sent only after the environment
# file is complete — so `After=` here means "the file the EnvironmentFile= below
# needs is on disk".
After=tv-shell-gamescope.service

# BindsTo, not just After. The core's entire job is reading and writing atoms on
# gamescope's root window; against a dead X server it is a process that either
# crash-loops or, worse, connects to some other ambient $DISPLAY and reports
# healthy. Neither is a state to leave running. BindsTo= stops it the moment the
# compositor goes, and the session target's own BindsTo= is bringing the whole
# session down at that point anyway — this makes the core's exit part of that
# rather than a race against it.
#
# PartOf= the target as well, so a plain `systemctl --user stop
# tv-shell-session.target` (the session script's cleanup path) takes the core
# with it. `Upholds=` starts and restarts; it does not stop.
BindsTo=tv-shell-gamescope.service
PartOf=tv-shell-session.target

# THERE IS DELIBERATELY NO `Conflicts=tv-shell-input.service` HERE ANY MORE.
#
# §11 is right that v1 and v2 must never run together — they contend for the
# seat, the pads and the CEC adapter, and both claim restart authority. But
# `Conflicts=` is BIDIRECTIONAL, and that is a loaded gun on this box.
#
# The `htpc_common` Ansible role ships a CEC watchdog as a SYSTEM unit that
# probes `cec-health`, misreads a deliberately stopped `tv-shell-input` as a
# wedged adapter, and restarts it (§9; jedwards1230/homelab-ansible#266). With
# `Conflicts=` in place, that restart issues a start job for tv-shell-input,
# which STOPS this unit — and the same directive on the session target stops the
# whole session. Mid-game the screen goes black and the box relogins, caused by a
# watchdog acting on a bad reading. That is the precise incident §9 was written
# about, wired into v2's own units.
#
# Mutual exclusion is enforced ONE-DIRECTIONALLY instead, by the session script:
# it stops the v1 units and `mask --runtime`s them before starting the target,
# and unmasks on the way out. A stray `systemctl --user start tv-shell-input`
# then FAILS LOUDLY against the mask instead of tearing down a live session, and
# a runtime mask cannot outlive the user manager, so a v2 session that dies badly
# can never leave v1 unstartable.
#
# THAT IS A MITIGATION, NOT THE FIX. §9 requires the watchdog to STAND DOWN at
# cutover and its health probe to distinguish a stopped unit from a wedged
# adapter. That work is on the Ansible side and is still unfiled there.

[Service]
Type=simple

# The compositor's environment, published by tv-shell-gamescope.service's ready
# handshake.
#
# NO LEADING `-`. It had one, and that made the ordering bug above SILENT: with
# the file missing the core started against whatever ambient $DISPLAY existed,
# connected to some other X server, and reported healthy — a black screen with a
# green `systemctl status`. That is precisely the silent-success class §3 exists
# to kill, and a session unit is the last place to trade falsifiability for
# convenience.
#
# The developer case that motivated the `-` (running the core by hand against an
# existing X server) is served WITHOUT weakening production: run the binary
# directly, or drop in an override that restores the tolerant form —
#   systemctl --user edit tv-shell-core.service
#   [Service]
#   EnvironmentFile=
#   EnvironmentFile=-%t/tv-shell-gamescope-environment
# An explicit local override is visible in `systemctl cat`; a `-` in the shipped
# unit is not.
EnvironmentFile=%t/tv-shell-gamescope-environment

# The core reads its typed config from ~/.config/tv-shell/core.toml itself and
# resolves its socket from $TV_SHELL_CORE_SOCK or /run/user/%U/. That is a
# SEPARATE file and a SEPARATE socket from v1's (§11: v1 and v2 share no config
# file, prefix or unit name), so no per-machine wiring belongs here.
#
# THE PREFIX IS A TOKEN, NOT A PATH. `scripts/install-v2.sh` substitutes
# @TV_SHELL_V2_PREFIX@ with its resolved --prefix (default /opt/tv-shell-v2) when
# it writes this unit into ~/.config/systemd/user/, exactly as scripts/install.sh
# rewrites the v1 units' ExecStart.
#
# A token rather than a default literal, and the difference matters here: v1's
# units carry a real /opt/tv-shell default because that IS their prefix, but a v2
# unit copied into place by hand with an unsubstituted default would exec V1's
# binary out of v1's prefix and look like it worked. `@TV_SHELL_V2_PREFIX@/bin/…`
# cannot be executed, so the same mistake fails loudly at the first start — the
# §3 rule applied to the installer. A test asserts the committed units name no
# absolute path and the installed ones carry no token.
ExecStart=@TV_SHELL_V2_PREFIX@/bin/tv-shell-core

# The core is stateless on start: it reads the base-layer list back as its last
# intent rather than asserting one (§9), so a restart is cheap and safe even
# with a game on screen.
#
# `Restart=always`, and the target `Wants=` this unit rather than `Upholds=` it.
# Those two go together and the pairing is the point.
#
# `Upholds=` restarts a unit even after a CLEAN exit, and specifically defeats a
# manual `systemctl --user stop` — that is its whole purpose. Combined with a
# `Restart=` on the unit it also gives one unit two independent restart
# mechanisms with no shared rate limit. The practical cost: an operator debugging
# over SSH cannot take the core down without stopping the session target, which
# blanks the television. `Restart=always` delivers §9's actual requirement (the
# core dies → it comes back) while still honouring an explicit stop job, which is
# the right end of that trade for a box someone has to debug remotely.
#
# No StartLimit* here ON PURPOSE. §9's crash-loop response (three exits under
# 60 s → back off, then select the v1 session) is NOT IMPLEMENTED — there is no
# short-session tracker and nothing reads [supervisor].restart_threshold. Adding
# a StartLimitBurst would look like that protection without being it, which is
# the mistake the gamescope unit's comment made. See tv-shell-session.target.
Restart=always
RestartSec=2

# No [Install] section by design — see the [Unit] comment.
