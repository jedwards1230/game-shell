[Unit]
# gamescope, the v2 compositor. UNTESTED ON HARDWARE — see the header in
# tv-shell-session.target.
#
# Type=notify with a ready-fd handshake, following docs/V2_DESIGN.md §4 and the
# ChimeraOS/SteamOS `gamescope-session` units this is derived from.
#
# THE HANDSHAKE, and why it is shaped this way:
#
#   The READY=1 that systemd waits for is sent by gamescope's own CHILD,
#   tv-shell-gamescope-child.sh, after it has published the compositor
#   environment (WAYLAND_DISPLAY, DISPLAY, GAMESCOPE_WAYLAND_DISPLAY,
#   XAUTHORITY) to %t/tv-shell-gamescope-environment. So `READY=1` means "the
#   environment file exists and is complete", which is exactly the precondition
#   every unit ordered after this one needs. A plain Type=simple would let the
#   core start against a compositor that has no X server yet and no environment
#   file to read, and the failure would present as "the core cannot connect to
#   X" rather than as a startup ordering bug.
#
#   THERE IS DELIBERATELY NO `-R <fifo>`. gamescope's ready-fd is the mechanism
#   the ChimeraOS units use, but here the child already provides the same
#   guarantee and provides it LATER — after the environment is published, which
#   is the part the core actually depends on. Passing `-R` as well would leave a
#   FIFO with a writer and no reader, and opening one blocks, so an unused ready
#   FIFO is not free: it is a startup hang waiting for a reader that this design
#   never creates.
#
#   THE DUMP CANNOT BE AN `ExecStartPost=`, TWICE OVER. First, systemd runs
#   ExecStartPost only AFTER the service counts as started, and under Type=notify
#   "started" means READY=1 has arrived — so an ExecStartPost that sends the
#   notification deadlocks against itself until TimeoutStartSec fires, and with
#   BindsTo= on the session target that kills the session on every boot. Second,
#   an ExecStartPost shell has the UNIT's environment, not gamescope's: it would
#   dump an empty file, `EnvironmentFile=-` would accept it silently, and the
#   core would connect to whatever ambient $DISPLAY exists. Both failures go away
#   when the dump runs inside gamescope's process tree, which is what the child
#   script is.
#
# NotifyAccess=all because the notification comes from that child, not from the
# main process.
Description=gamescope compositor for the tv-shell v2 session
Before=graphical-session.target
Wants=graphical-session.target

[Service]
Type=notify
NotifyAccess=all
# The handshake must complete promptly; a compositor still not ready after five
# seconds is wedged, not slow.
TimeoutStartSec=5

# The stats FIFO is created by the session script before the target is started,
# so it exists by the time gamescope opens it. %t is $XDG_RUNTIME_DIR.
Environment=TV_SHELL_STATS_FIFO=%t/tv-shell-gamescope-stats
Environment=TV_SHELL_ENV_FILE=%t/tv-shell-gamescope-environment

# THE OUTPUT MODE, AND WHY IT IS NOT WRITTEN HERE.
#
# This file used to hard-code `-W 3840 -H 2160 -r 120` while [display] in
# core.toml documented itself as "read by the unit's ExecStart". It was not: an
# operator could set `refresh = 60`, watch the core's validate() accept it, and
# change nothing. Two literals with no link between them.
#
# Now `tv-shell-core write-session-env` renders this file from core.toml, the
# session script runs it BEFORE starting the target, and the substitutions below
# are the link. NO LEADING `-`: if the file is missing the mode is unknown, and
# starting a 4K120-pinned compositor with an unknown mode is exactly the silent
# success §3 exists to kill. Fail loudly instead.
EnvironmentFile=%t/tv-shell-gamescope-mode

# §9: a layer failure must exit loudly rather than ask an invisible question.
# gamescope's zenity dialogs are untagged windows nobody can see, and a client
# blocked behind one hangs at 0% CPU with no log line for as long as you let it.
Environment=GAMESCOPE_ZENITY_DISABLE=1

# The mode is PINNED (§6): the EDID preferred mode on this chain is 60 Hz, so
# letting the display choose gives 4K60.
#
# `--steam` selects the SteamControlled focus policy the whole §5 model depends
# on. It has a short form, `-e`, and this unit used to pass BOTH — one flag
# twice, with the bare `-e` reading like the xwayland-count flag it is not.
# `--xwayland-count` is long-only and takes an argument; `-e` takes none, so a
# reader "fixing" the mismatch by writing `-e 2` hands gamescope `2` as its child
# command, gamescope execs it, it fails instantly, BindsTo= stops the target and
# the television relogins forever. Long forms only here for that reason.
#
# `--expose-wayland` stays ON: §11's per-app fix (unset WAYLAND_DISPLAY for
# Steam-runtime apps) is proven, and chasing the problem via gamescope master
# instead recreates it.
#
# `--stats-path` (not the short `-T`) matches dev/gamescope/session.sh:144, the
# exact invocation the week-long live measurement ran, so there is no question
# about which flag was measured. On the stats FIFO having no reader: that is the
# live appliance's own configuration — the kit creates the FIFO, nothing tails it
# unless an operator does, and gamescope does not hang. The kit records why
# (dev/gamescope/session.sh:86-89): gamescope open()s an EXISTING FIFO and, when
# nothing is on the other end, retries every 10 s rather than blocking. §9's
# stats relay is still the intended permanent reader; until it lands the stats
# simply do not appear, which is a missing feature and not a startup risk.
#
# gamescope's PRIMARY CHILD, and the whole ready handshake. gamescope exits
# when this command exits, so `-- /bin/true` would end the compositor
# immediately. The script dumps the environment from inside gamescope's process
# tree, then sends READY=1, then holds the slot open (see its header — the hold
# is an honest placeholder for §4's real session child, not finished work).
#
# Rewrite this path to the resolved install prefix, as scripts/install.sh does
# for the v1 units.
ExecStart=/usr/bin/gamescope \
    --steam \
    --expose-wayland \
    --hdr-enabled \
    --adaptive-sync \
    -W ${TV_SHELL_GS_WIDTH} -H ${TV_SHELL_GS_HEIGHT} -r ${TV_SHELL_GS_REFRESH} \
    --xwayland-count ${TV_SHELL_GS_XWAYLAND_COUNT} \
    --stats-path ${TV_SHELL_STATS_FIFO} \
    -- /opt/tv-shell/bin/tv-shell-gamescope-child.sh

# No Restart=: the compositor is BindsTo'd by the session target, so its death
# is meant to end the session and hand control back to the display manager,
# not to be papered over by a restart under a session whose clients have all
# lost their surfaces.
#
# AND THEREFORE NO StartLimit* EITHER. This unit used to carry
# StartLimitIntervalSec=60 / StartLimitBurst=3 with a comment promising "three
# attempts in a minute, then offer v1". That protection did not exist: with
# Restart=no there is never a second attempt for the limiter to count, and the
# session script's `reset-failed` clears the counter on every relogin anyway. A
# comment claiming a protection that is not there is worse than no protection,
# because it stops the next person looking. §9's short-session tracker — the
# thing that would actually catch a crash-loop and select v1 — IS NOT
# IMPLEMENTED. See tv-shell-session.target's header.
Restart=no
