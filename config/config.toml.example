# Per-machine configuration for the tv-shell input daemon.
#
# Copy to ~/.config/tv-shell/config.toml and edit. The daemon reads this
# typed TOML file directly at startup (it replaced the old daemon.env env file).
# Everything here is OPTIONAL — with no config.toml the shell still boots; these
# sections only turn on the LAN control surface and the optional Plex / Steam
# home-screen widgets.
#
# ALL secrets (HTTP bearer, Plex, Steam, MQTT password) are by reference only —
# never inline.
# Each lives in a separate file that the matching `*_token_file` points at. Every
# token file MUST be mode 0600 AND live under ~/.config/tv-shell/ — the daemon
# refuses to start on a world-readable token file or a path that escapes the
# config dir. Generate the bearer token:
#   install -m600 /dev/null ~/.config/tv-shell/http-token
#   openssl rand -hex 32 > ~/.config/tv-shell/http-token
#
# The daemon REFUSES to start if a control surface is bound to a non-loopback
# address with dev tools on and auth effectively off — unless you explicitly set
# [dev].allow_insecure_lan = true (see the very bottom). The web control panel
# (`tv-shell-panel`, [panel] below) refuses the same combination, reading the
# same [dev].allow_insecure_lan flag, so a node has ONE insecure-LAN opt-in.

# --- LAN control surface (HTTP bridge) ---------------------------------------
[http]
# Bind address for the HTTP/1.1 control bridge (GET /screenshot, POST intents,
# /dev/* deploy tools). Omit/comment out to leave the bridge off. Use
# 127.0.0.1:8089 for local-only, or 0.0.0.0:8089 to expose it on the LAN
# (firewall it yourself, and keep auth on).
#bind = "127.0.0.1:8089"

# Require a bearer token on the HTTP bridge + MCP server. Default true. Only set
# false on a trusted, firewalled LAN (and see [dev].allow_insecure_lan).
#auth_enabled = true

# Path to the 0600 file holding the shared bearer token (HTTP bridge + MCP).
# Required when auth_enabled = true. ~ is expanded to $HOME.
#token_file = "~/.config/tv-shell/http-token"

# --- Web control panel (optional, separate `tv-shell-panel` binary) ----------
# tv-shell-panel is a LAN-only web control panel that runs as its own systemd
# --user unit (config/tv-shell-panel.service) beside the daemon. It is part of
# the LAN control surface documented here, but the daemon does NOT read these
# values itself — it only parses-and-ignores this section so a shared
# config.toml doesn't fail the daemon's `deny_unknown_fields` validation. The
# tv-shell-panel binary is the actual consumer; see docs/PANEL.md.
[panel]
# Whether the panel serves when its unit runs. Default true.
#enabled = true

# Bind address for the panel's own HTTP server (separate from [http] above).
# Default 127.0.0.1:8091 (local-only). Use 0.0.0.0:8091 to expose it on the LAN
# — and then you MUST set token_file below: the panel REFUSES to start on a
# non-loopback bind with no token, unless [dev].allow_insecure_lan = true (the
# same flag the daemon uses; see the very bottom).
#bind = "127.0.0.1:8091"

# Path to the 0600 file holding the panel's own credential. Setting it turns
# panel authentication ON: a browser signs in at /login (the token is exchanged
# for an HttpOnly + SameSite=Strict session cookie) and scripts send
# `Authorization: Bearer <token>`. Every route is gated except GET /login,
# POST /login and the two static assets.
#
# Same rules as [http].token_file: mode 0600 AND under ~/.config/tv-shell/ —
# the panel refuses to start on a world-readable file or a path escaping the
# config dir, rather than silently degrading to "no auth". It also refuses an
# EMPTY file (that would 401 every request and every /login submission, locking
# you out of the recovery panel) and a token holding characters a cookie value
# cannot carry — space, ";", ",", '"', "\" or non-ASCII — which would silently
# break browser login forever. Generate one with:
#   install -m600 /dev/null ~/.config/tv-shell/panel-token
#   openssl rand -hex 32 > ~/.config/tv-shell/panel-token
#
# Leaving it unset means NO panel auth, which is only permitted on a loopback
# bind. Use a token distinct from [http].token_file — that one is the daemon's.
#token_file = "~/.config/tv-shell/panel-token"

# Allow the panel's root-equivalent actions. Default FALSE: a fresh node gets
# the read-only + recovery surface (status, logs, settings/widgets editors,
# unit restarts, CEC recovery) without the actions that can overwrite the
# running build or take the box down. The rule: restarting a unit is RECOVERY
# (ungated); changing what code runs, powering the box, or running arbitrary
# commands is ROOT-EQUIVALENT (gated). When false these routes are NOT
# registered at all (404) and their buttons are not rendered:
#   POST /dev/deploy, /dev/build, /dev/reboot, /dev/suspend,
#   /system/updates/apply (sudo pacman -Syu),
#   /dev/console/raw (the arbitrary-IPC console)
# Every unit-restart route stays available — /system/services/restart/{key},
# /dev/restart-daemon, /dev/restart-shell and /devices/cec/recover/restart-daemon all
# drive the same systemd units, and recovery is the reason the panel exists.
#allow_dangerous = false

# Units the panel's System ▸ Services page may RESTART, beyond the three
# built-in tv-shell ones. Read by the PANEL binary only.
#
# READ AND RESTART ARE DELIBERATELY ASYMMETRIC. Reading any unit's status is
# inert, so the Services page's "Inspect any unit" form takes any unit name in
# either scope and needs no config at all. Restarting is not inert — restarting
# sshd on a headless box can strand it, and restarting an ARBITRARY unit is a
# general privilege-escalation primitive — so restart is allowlisted here.
#
# Each entry is resolved SERVER-SIDE: the browser only ever sends `key`, and
# `POST /system/services/restart/{key}` looks it up in this table. A unit name
# from the client never reaches systemctl on any path.
#
# The three tv-shell units (keys `daemon`, `shell`, `panel`) are built in and
# must NOT be listed here — a key that collides with one of them is a startup
# error, so a config typo can never cost you the recovery path. Anything else
# malformed (empty/duplicate key, a `unit` that is not a plausible systemd unit
# name, a `scope` that is not exactly "system" or "user") also aborts startup
# rather than being silently dropped.
#
# scope = "user"   -> `systemctl --user restart <unit>`. No elevation; keeps
#                     working with the daemon down.
# scope = "system" -> `sudo -n systemctl restart <unit>`, which REQUIRES a
#                     per-unit NOPASSWD sudoers line on this host, e.g.
#
#   tv-shell ALL=(root) NOPASSWD: /usr/bin/systemctl restart sshd.service, \
#                                 /usr/bin/systemctl restart NetworkManager.service
#
#                     (substitute the panel's unit user and the real systemctl
#                     path). Narrow per-unit entries, never blanket systemctl.
#                     With no matching line, `sudo -n` refuses immediately and
#                     the panel reports "NOT PERMITTED on this node" naming the
#                     unit — it fails CLOSED, never a silent no-op. That is the
#                     state of every node today: the ansible-side generation of
#                     these sudoers lines (htpc_common role) has not landed, so
#                     listing a system-scope unit here makes it readable and
#                     visible, but not yet restartable.
#managed_units = [
#  { key = "sshd",      unit = "sshd.service",           scope = "system" },
#  { key = "network",   unit = "NetworkManager.service", scope = "system" },
#  { key = "bluetooth", unit = "bluetooth.service",      scope = "system" },
#]

# Remote SIDECAR nodes this panel serves over HTTP (docs/MULTI_NODE_PANEL.md
# §4) — read by the PANEL binary only, never the daemon. One entry per sidecar
# (e.g. tv-shell-host on a gaming PC); base_url is its HTTP listener,
# sidecar_token_file a 0600 file holding ITS bearer token, same hygiene as
# [panel].token_file above (0600, must live under ~/.config/tv-shell/, or the
# panel refuses to start). Never point this at another tv-shell SHELL node's
# own token — that panel is a peer reachable by link, not a credential this
# one holds.
#
# Nested under [panel] deliberately: config.toml is shared, and the daemon's
# top-level parser is deny_unknown_fields, so a top-level [[nodes]] would abort
# DAEMON startup. The daemon tolerates unknown keys inside [panel] by design.
#
# Nothing serves an entry here yet: HttpTransport and this config resolve, but
# the node switcher that would actually render a second node's UI hasn't
# landed (docs/MULTI_NODE_PANEL.md sequencing step 6).
#[[panel.nodes]]
#id = "desktop-2"
#base_url = "http://192.168.8.153:47995"
#sidecar_token_file = "~/.config/tv-shell/desktop-2-sidecar-token"

# --- MCP server (optional, requires the daemon built with --features mcp) -----
[mcp]
# Streamable-HTTP MCP endpoint at /mcp exposing the daemon's control surface as
# tools. Omit to leave it off. Shares [http].token_file + [http].auth_enabled.
#bind = "127.0.0.1:8090"
# Enable the dev tool surface (build/restart/deploy). Leave off in production.
#dev = false
# Host header allowlist (DNS-rebinding guard). Empty ⇒ allow-all (token-gated).
#allowed_hosts = ["localhost", "my-host.local"]

# --- HDMI-CEC lifecycle (optional, requires the daemon built with --features cec)
[cec]
# Daemon wakes the AV chain on start/resume and standbys it on suspend.
#lifecycle = false
# OSD device name announced on the CEC bus — the input label TVs/AVRs display
# for this machine. Absent ⇒ the machine hostname (same name as SSH/network).
# ASCII, max 13 chars (libcec limit); longer values are truncated.
# Editable from the web panel's CEC page (daemon restart applies it).
#osd_name = "living-room"

# --- Plex home-screen widget (optional) --------------------------------------
[plex]
# On Deck / Recently Added hubs on the home screen. BOTH a url and a token are
# required or the widget collapses even when toggled on in settings.
#url = "http://plex-host:32400"
# The Plex token is by reference only (a 0600 file inside ~/.config/tv-shell/);
# inline tokens are not supported (same policy as [http]). Must be mode 0600 and
# live under the config dir or the daemon refuses to start.
#token_file = "~/.config/tv-shell/plex-token"

# --- Steam library row (optional) --------------------------------------------
[steam]
# Points at a tv-shell-host sidecar (see docs/HOST_SETUP.md) running on the
# gaming PC to enumerate and launch installed Steam games. BOTH url and token
# are required or the Steam row collapses; the token must match the host's token.
#url = "http://gaming-pc:47995"
# Token by reference only (0600 file under ~/.config/tv-shell/); inline tokens
# are not supported. The token must match the host's TV_SHELL_HOST_TOKEN.
#
# MULTIPLE sidecars (e.g. a dual-boot gaming PC with one identity per OS, or
# several gaming PCs): declare named [[steam.hosts]] entries INSTEAD of `url`
# (when any entry is present, `url` is ignored). The active one is selected
# from the couch — Widgets ▸ Steam ▸ Server — via the `steam-set-host` IPC
# (persisted as `steamServer` in settings.json; default = the first entry).
# Names must be unique and non-empty; a per-entry token_file overrides the
# shared [steam].token_file above.
#
# Optional per-entry `mac`: the host's Ethernet MAC, pinned for Wake-on-LAN.
# PREFERRED over discovery when set. Without it the daemon can only learn the MAC
# from the live neighbor table (`ip neigh`) or its persisted host-macs.json cache
# — so a host that has slept long enough to age out of the neighbor table with a
# cold cache cannot be woken at all (`wol` replies reason "no-mac"). Colon or dash
# separated; an unparseable value aborts daemon startup rather than failing
# silently at wake time.
#[[steam.hosts]]
#name = "desktop-1"
#url = "http://192.0.2.1:47995"
#mac = "aa:bb:cc:dd:ee:ff"
#[[steam.hosts]]
#name = "desktop-2"
#url = "http://192.0.2.2:47995"
#mac = "aa:bb:cc:dd:ee:ff"          # same NIC on a dual-boot box ⇒ same MAC
#token_file = "~/.config/tv-shell/steam-token-desktop-2"
#token_file = "~/.config/tv-shell/steam-token"
#
# Proactively send a Wake-on-LAN packet to the ACTIVE host (only that one — never
# the whole [[steam.hosts]] list) at daemon startup and whenever `steam-set-host`
# switches the selection. Default false: waking a machine is a side effect on
# someone else's hardware, so it stays opt-in. Fail-soft — a failed wake is logged
# and never blocks startup or the IPC reply. Pair it with `mac` above, otherwise a
# long-asleep host still can't be resolved.
#wake_active_host_on_start = false

# --- MQTT state publisher + command surface (optional) -----------------------
# The daemon's only OUTBOUND network surface: it dials the broker, publishes its
# state retained, and subscribes to a command topic. Full reference (topics,
# entity keys, Home Assistant discovery): docs/MQTT.md.
#
# Absent `broker` ⇒ MQTT is off entirely: no connection, no discovery published.
#
# A misconfigured [mqtt] does NOT stop the daemon. It is logged at `error` naming
# the offending field, the MQTT actor is skipped, and the shell/CEC/input come up
# normally — so the symptom of a typo here is "no device in Home Assistant", not
# a dead TV. (A *malformed* table is a different mechanism: this file is parsed
# with deny_unknown_fields, so an unknown KEY still fails the TOML parse and
# aborts startup. That is why every line below stays commented.)
#
# There is NO config-reload path — DaemonConfig::load() runs once and watch.rs
# watches settings.json only. Any change here, credential rotation included,
# needs a daemon restart, and a daemon restart hands the CEC adapter to whatever
# grabs it next. Rotating the MQTT password is outage-adjacent, not a config edit.
[mqtt]
# Broker URL. Only mqtt:// (default port 1883) and mqtts:// (default port 8883)
# are accepted; cleartext mqtt:// logs a warning because the password and every
# state payload then cross the LAN unencrypted.
#broker = "mqtts://mqtt.example:8883"

# This machine's identity — EXPLICIT and required whenever `broker` is set, never
# derived from hostname/OS/IP. A dual-boot machine must publish the SAME id from
# both OSes; a derived id registers two Home Assistant devices for one machine,
# one of which is permanently offline by construction. Alphabet is [A-Za-z0-9_-],
# max 64 bytes (so it can never inject a topic level or an MQTT wildcard).
#device_id = "htpc-1"

# Broker credentials. Set BOTH or NEITHER — a half-set pair would authenticate
# anonymously and look like a broker-side ACL problem. The password is by
# reference only and follows the same rules as every other token file: mode 0600
# and under ~/.config/tv-shell/, or MQTT is disabled.
#username = "tv-shell-htpc-1"
#password_file = "~/.config/tv-shell/mqtt-password"

# PEM CA bundle — OPTIONAL and usually unnecessary. The broker presents a
# publicly-trusted certificate, so the platform trust store is the normal path;
# set this only for a private CA. A CA certificate is public, so unlike a token
# file it is tilde-expanded but NOT mode-checked and NOT confined to the config
# dir. An unreadable file warns and falls back to the platform store.
#ca_file = "~/.config/tv-shell/mqtt-ca.pem"

# Floor heartbeat: republish at least this often even when nothing changed, so
# `published_at`/`seq` always advance. That floor is the only signal that catches
# a half-open socket (see docs/MQTT.md). Default 30. Must be > 0.
#heartbeat_secs = 30

# MQTT keepalive. Generous by default — reconnect churn on a broker that home
# automation also rides on is a real risk. Default 60. Must be > 0.
#keepalive_secs = 60

# --- Observability: logs + metrics (optional) --------------------------------
# See docs/OBSERVABILITY.md for the full emit contract (metric catalogue, etc.).
[observability]
# Logging backend. Omit/unset = auto (journald when launched under systemd, i.e.
# JOURNAL_STREAM is set; stdout otherwise). true = force the systemd journal
# (tracing-journald: structured fields + syslog priority); false = force stdout.
#log_journal = true
# Standard tracing log level/targets stay an ENV var (RUST_LOG), not a config key
# — e.g. `RUST_LOG=debug tv-shell-input`. Default: info.
#
# Metrics PRIMARY path: node_exporter textfile collector. Absolute path to the
# .prom file to write. Omit/unset = textfile writer disabled (the /metrics HTTP
# route on the bridge, when [http].bind is set, is unaffected).
#metrics_textfile = "/var/lib/node_exporter/textfile/tv-shell.prom"
# Textfile render/write interval in seconds. Default 15; 0 falls back to 15.
#metrics_interval = 15

# --- Per-app input contracts (optional) --------------------------------------
# How the daemon presents the controller fleet to a focused external window,
# keyed by its Hyprland window class. Follow-focus picks the presenter from the
# focused window's contract:
#   gamepad  — forward each pad to a clean per-player virtual Xbox pad (the app
#              reads a real gamepad). DEFAULT for any class not listed below.
#   keyboard — emulate keyboard/mouse from the pad, aimed at the focused app
#              (d-pad→arrows, A→Enter, B→Esc, sticks→arrows/mouse). NO virtual
#              pad exists — so a key-driven HTPC app (e.g. Plex) is drivable, and
#              Steam has no always-alive virtual pad to exclusive-grab out from
#              under the focused app (the reason this section exists).
#   handoff  — ungrab the physical pad entirely so the app reads the raw evdev
#              node directly (SDL/Moonlight-style). No virtual pad, no emulation.
#
# Built-in defaults (no config needed): "tv.plex.Plex" = keyboard, everything
# else = gamepad. Entries here OVERRIDE the built-ins. Read once at startup —
# changing a contract needs a daemon restart. Find a window's class with
# `hyprctl activewindow` (the `class:` field) while it is focused.
#
# --- Meta (Guide) + combo timing (optional) ----------------------------------
# meta_hold_ms  — Meta/Guide (BTN_MODE) tap-vs-hold threshold in ms (default 500).
#                 Held past this = HOLD, the reserved shell escape (raises the
#                 controllable overlay drawer over a focused app; a full reset on
#                 the shell home). Released before = TAP, delivered to the focused
#                 app per its contract (Game: a real Guide tap to the pad;
#                 Keyboard: nothing). Meta is never leaked to the app while the
#                 daemon discriminates tap vs hold.
# combo_guard_ms — combo settle window in ms (default 120). While a focused app
#                 owns the screen the daemon briefly buffers a safety-combo
#                 participant press (Back/Home/LB/RB/Start/B) instead of forwarding
#                 it, so a PARTIAL combo never leaks in as a stray media key; a
#                 genuine single-button press replays after at most this long.
# These must appear under [input] BEFORE the [input.contracts] sub-table below.
[input]
#meta_hold_ms = 500
#combo_guard_ms = 120

[input.contracts]
#"tv.plex.Plex" = "keyboard"       # (built-in; shown for reference)
#"steam" = "gamepad"               # (built-in; Big Picture takes a real pad)
#"org.videolan.VLC" = "keyboard"   # a media player you drive with the d-pad

# --- Operator escape hatch ---------------------------------------------------
[dev]
# Explicitly permit the otherwise-refused combination of a non-loopback bind +
# dev tools + auth effectively disabled. This downgrades the hard startup refusal
# to a loud warning. Only enable on a trusted, firewalled, single-user dev box
# (e.g. a dedicated gaming client) where you WANT the unauthenticated LAN dev
# loop. Default false.
#
# READ BY BOTH BINARIES: the daemon (HTTP bridge + MCP server) and the web
# control panel. Setting it opens both — there is deliberately no panel-only
# variant, so there is one flag to audit per node rather than two.
#allow_insecure_lan = false
