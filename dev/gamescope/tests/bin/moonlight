#!/bin/bash
# Fake moonlight-qt: records its argv, `list` prints the fixture names, `quit`
# flips the fake serverinfo to idle, `stream` runs until killed.
set -u
printf '%s\n' "$@" > "${FAKE_X:-/tmp}/moonlight.argv"
case "${1:-}" in
    list)
        printf '%s\n' " Desktop" " Steam Big Picture" "Factorio" "Stardew Valley"
        ;;
    quit)
        sed -i 's#<currentgame>[0-9]*</currentgame>#<currentgame>0</currentgame>#; s#SUNSHINE_SERVER_BUSY#SUNSHINE_SERVER_FREE#' "$FAKE_SERVERINFO"
        echo "quit sent" >> "${FAKE_X:-/tmp}/moonlight.log"
        ;;
    stream)
        echo "streaming $2 [$3]" >> "${FAKE_X:-/tmp}/moonlight.log"
        sleep 300
        ;;
    *)
        sleep 300
        ;;
esac
